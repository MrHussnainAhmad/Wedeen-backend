{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/mongodb-ping",
      "schedule": "0 0 * * 0"
    }
  ],
  "rewrites": [
    {
      "source": "/api/compliance/delete-account",
      "destination": "/api/compliance/delete-account.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__pathname=/api/$1"
    }
  ]
}
